// mdq-doc: # Native frontmatter query
// mdq-doc:
// mdq-doc: Native queries operate on arbitrary YAML frontmatter. Dotted paths
// mdq-doc: and array indices are structural only; no property name is reserved.
// mdq-doc:
// mdq-doc: Input:
// mdq-doc:   mdq query 'status = active and score >= 8' --json
// mdq-doc:   mdq pipeline --stage 'filter:status = active'
// mdq-doc:
// mdq-doc: When to use:
// mdq-doc:   Use native queries for direct frontmatter predicates over notes.
// mdq-doc:   Use Dataview or Base when you need table projection, source clauses,
// mdq-doc:   grouping, summaries, or compatibility with saved Obsidian queries.
// mdq-doc:
// mdq-doc: Boolean syntax:
// mdq-doc:   EXPR and EXPR
// mdq-doc:   EXPR or EXPR
// mdq-doc:   not EXPR
// mdq-doc:   (EXPR)
// mdq-doc:
// mdq-doc: Operators:
// mdq-doc:   =  ==  !=  >  >=  <  <=
// mdq-doc:   contains        string substring, array element, or object key
// mdq-doc:   contains_all    every expected array element is present
// mdq-doc:   overlaps        at least one expected array element is present
// mdq-doc:   in              value occurs in expected array
// mdq-doc:   starts_with     string prefix
// mdq-doc:   ends_with       string suffix
// mdq-doc:   matches         regular expression; applies to a string field or to each
// mdq-doc:                   element of an array field (any match = true); an invalid
// mdq-doc:                   pattern is rejected at parse time with an error
// mdq-doc:   exists          path exists
// mdq-doc:   missing         path does not exist
// mdq-doc:
// mdq-doc: Values use YAML syntax: strings, numbers, booleans, null, flow
// mdq-doc: lists, and flow objects. Numbers compare numerically. ISO dates and
// mdq-doc: RFC 3339 timestamps compare chronologically.
// mdq-doc:
// mdq-doc: Examples:
// mdq-doc:   mdq query 'status = active and score >= 3'
// mdq-doc:   mdq query 'arbitrary.items contains value'
// mdq-doc:   mdq query 'tags matches "daily"'
// mdq-doc:   mdq query 'date >= 2026-01-01'
// mdq-doc:   mdq query 'nested.key exists'
// mdq-doc:
// mdq-doc: Output:
// mdq-doc:   Native queries return matching notes as `{path, title}` rows.
// mdq-doc:
// mdq-doc: This language is also available as `filter:` in retrieval pipelines.
// mdq-doc:
// mdq-doc: Related manuals:
// mdq-doc:   mdq manual query
// mdq-doc:   mdq manual pipeline

WHITESPACE = _{ " " | "\t" | NEWLINE }

expression = { SOI ~ or_expr ~ EOI }
or_expr = { and_expr ~ (OR ~ and_expr)* }
and_expr = { unary_expr ~ (AND ~ unary_expr)* }
unary_expr = { NOT ~ unary_expr | "(" ~ or_expr ~ ")" | predicate }

predicate = {
    path ~ (
        EXISTS
      | MISSING
      | operator ~ value
    )
}

operator = {
      CONTAINS_ALL
    | STARTS_WITH
    | ENDS_WITH
    | CONTAINS
    | OVERLAPS
    | MATCHES
    | IN
    | GTE
    | LTE
    | NE
    | EQ
    | GT
    | LT
}

OR = _{ ^"or" }
AND = _{ ^"and" }
NOT = { ^"not" }
EXISTS = { ^"exists" }
MISSING = { ^"missing" }
CONTAINS_ALL = { ^"contains_all" }
STARTS_WITH = { ^"starts_with" }
ENDS_WITH = { ^"ends_with" }
CONTAINS = { ^"contains" }
OVERLAPS = { ^"overlaps" }
MATCHES = { ^"matches" }
IN = { ^"in" }
GTE = { ">=" }
LTE = { "<=" }
NE = { "!=" }
EQ = { "==" | "=" }
GT = { ">" }
LT = { "<" }

path = @{ path_char+ }
path_char = { !(WHITESPACE | "(" | ")" | "=" | "!" | ">" | "<") ~ ANY }

value = @{ collection | double_quoted | single_quoted | bare }
collection = { ("[" ~ collection_char* ~ "]") | ("{" ~ collection_char* ~ "}") }
collection_char = { double_quoted | single_quoted | (!("[" | "]" | "{" | "}") ~ ANY) }
double_quoted = { "\"" ~ ("\\\"" | !"\"" ~ ANY)* ~ "\"" }
single_quoted = { "'" ~ ("\\'" | !"'" ~ ANY)* ~ "'" }
bare = { (!(WHITESPACE | "(" | ")") ~ ANY)+ }
